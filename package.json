{
  "name": "weft",
  "version": "1.0.0",
  "private": true,
  "description": "Weft \u2014 language immersion woven into your browsing. A partial-translation reading layer with attention-linked difficulty.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:firefox": "node build.mjs --target=firefox",
    "build:all": "node build.mjs --target=chrome && node build.mjs --target=firefox",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:dom",
    "test:unit": "node --test --experimental-strip-types \"tests/core/*.test.ts\"",
    "test:dom": "node --test --experimental-strip-types \"tests/dom/*.test.ts\"",
    "test:e2e": "npm run build:test && playwright test",
    "test:all": "npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "packs": "node tools/build-pack.mjs --all",
    "packs:verify": "node tools/verify-packs.mjs",
    "zip": "node build.mjs --target=chrome --zip && node build.mjs --target=firefox --zip",
    "lint": "tsc --noEmit",
    "build:test": "node build.mjs --target=chrome --test",
    "release": "node tools/release.mjs",
    "site": "node tools/build-site.mjs",
    "og": "node tools/make-og.mjs",
    "licence": "node tools/make-licence.mjs",
    "site:check": "node tools/check-links.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/chrome": "^0.0.287",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.1",
    "preact": "^10.25.1",
    "typescript": "^5.7.2"
  }
}
